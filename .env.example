APP_NAME="YAC-BulkSMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yac_bulksms
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session, cache and queues
# ---------------------------------------------------------------------------
# Use the database driver for sessions and cache. Queues default to the
# database driver so that no extra infrastructure is required to start.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database

QUEUE_CONNECTION=database
QUEUE_NAME=default

# ---------------------------------------------------------------------------
# Mail (used for nothing except optional framework notifications)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Termii (shared account). These are the only place the real API key should
# live. Never commit a filled .env file.
# ---------------------------------------------------------------------------
TERMII_API_KEY=
# Optional: Termii may issue an account specific base URL.
TERMII_BASE_URL=https://v4.api.termii.com
# Fallback sender ID used if the value stored in application settings is empty.
TERMII_SENDER_ID=
TERMII_CHANNEL=generic
TERMII_TIMEOUT=30
TERMII_THROW=false

# Delivery report (DLR) webhook. Create a random secret, store it here and
# configure the same secret/webhook URL in the Termii developer console.
# Leave empty to disable the webhook endpoint entirely.
TERMII_WEBHOOK_SECRET=
TERMII_WEBHOOK_ENABLED=false

# ---------------------------------------------------------------------------
# Background jobs / operational defaults
# ---------------------------------------------------------------------------
# Seconds a claimed recipient may stay "processing" before it is treated as an
# interrupted job and flagged for reconciliation (never auto-resent).
YAC_STALE_CLAIM_MINUTES=15
YAC_QUEUE_RETRY_AFTER=120

# ---------------------------------------------------------------------------
# First administrator created by "php artisan db:seed" / "migrate --seed".
# Change the password immediately after the first login.
# ---------------------------------------------------------------------------
ADMIN_NAME="YAC Administrator"
ADMIN_EMAIL=admin@yac-bulksms.test
# Leave empty to generate a random password (printed once by the seeder).
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
